# Copy to .env and adjust. Every setting is optional.

# ---- Server ----
# 127.0.0.1 = only this machine (Lavalink on the same PC/VPS). Use 0.0.0.0 to accept remote
# connections, and set a PASSWORD if you do.
HOST=127.0.0.1
PORT=8001
# Required on every request except GET / and /health, sent either as the `Authorization`
# header (Lavalink's remoteCipher.password does this) or as `?password=` in the URL
# (needed for LavaSrc's customTokenEndpoint).
PASSWORD=
# debug | info | warn | error
LOG_LEVEL=info

# ---- Spotify tokener (GET /api/token) ----
SPOTIFY_ENABLED=true
# Chrome / Chromium / Edge / Brave executable. Auto-detected when empty.
BROWSER_PATH=
# Start the browser with --no-sandbox (needed in most containers; the Dockerfile sets it).
BROWSER_NO_SANDBOX=false
# Your sp_dc cookie (same value as lavasrc.spotify.spDc). Lets the account token, which
# Spotify lyrics need, be fetched at startup instead of on the first lyrics request.
SPOTIFY_SP_DC=
# Keep refreshing tokens in the background while they were requested within this many hours.
SPOTIFY_KEEP_WARM_HOURS=12
# Close the headless browser after this many ms without work (0 = keep it running).
SPOTIFY_BROWSER_IDLE_MS=300000
# Give up on a single token fetch after this many ms.
SPOTIFY_TIMEOUT_MS=20000

# ---- YouTube cipher (POST /get_sts, /resolve_url, /decrypt_signature) ----
CIPHER_ENABLED=true
# Player script variant to solve with. yt-cipher recommends IAS; "auto" uses the requested one.
# Other values: IAS_TCC IAS_TCE ES5 ES6 ES6_TCC ES6_TCE TV TV_ES6 PHONE EMBED EMBED_ES6 HOUSE
CIPHER_PLAYER_VARIANT=IAS
# Force one player script ID (8 characters). Empty = use the requested one.
CIPHER_PLAYER_ID=
# Share one cache entry across regional copies of the same player version.
CIPHER_IGNORE_SCRIPT_REGION=false
# Where downloaded player scripts are stored. Default: ./cache/players
CIPHER_CACHE_DIR=
